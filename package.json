{
  "name": "ruo-ufms",
  "version": "2.0.0",
  "description": "Ruo — University Facilities Management System (UFMS)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server test",
    "client:install": "npm install --prefix client --legacy-peer-deps",
    "client:test": "npm test --prefix client"
  },
  "keywords": [
    "ufms",
    "university-facilities",
    "digital-twin",
    "csp-timetable",
    "sla-reactor"
  ],
  "author": "Ruo Development Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
