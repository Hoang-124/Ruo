// ═══════════════════════════════════════
// MODULE 1: AUTH & USER MANAGEMENT
// Actors: All (Lecturer, Maint Staff, Admin)
// ═══════════════════════════════════════

Table users {
  _id ObjectId [pk]
  code String [unique, note: 'Mã NV / GV']
  email String [unique]
  password_hash String [note: 'BCrypt']
  full_name String
  phone String
  avatar String
  department String [note: 'Khoa / Phòng ban']
  role String [note: 'lecturer | maintenance_staff | admin']
  status String [note: 'active | locked']
  force_change_pw Boolean
  last_login_at DateTime
  login_count Number
  created_at DateTime
  updated_at DateTime
}

Table roles {
  _id ObjectId [pk]
  name String [unique, note: 'lecturer | maintenance_staff | admin']
  permissions Array [note: 'Mảng quyền chi tiết']
}

Table refresh_tokens {
  _id ObjectId [pk]
  user_id ObjectId [ref: > users._id]
  token String [note: 'Hash']
  device_info String
  ip_address String
  expires_at DateTime [note: 'TTL 7 ngày']
  is_revoked Boolean
  created_at DateTime
}

Table login_history {
  _id ObjectId [pk]
  user_id ObjectId [ref: > users._id]
  ip_address String
  user_agent String
  status String [note: 'success | failed | locked']
  failure_reason String [note: 'wrong_password | account_locked | rate_limited']
  created_at DateTime [note: 'TTL 90 ngày']
}
