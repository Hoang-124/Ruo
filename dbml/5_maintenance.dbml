// ═══════════════════════════════════════
// MODULE 5: MAINTENANCE & INVENTORY
// Actor: Maintenance Staff
// ═══════════════════════════════════════

Table equipment {
  _id ObjectId [pk]
  code String [unique]
  name String
}

Table rooms {
  _id ObjectId [pk]
  code String [unique]
  name String
}

Table maintenance_plans {
  _id ObjectId [pk]
  name String [note: 'Tên kế hoạch']
  target_type String [note: 'room | equipment | category']
  target_ids Array [note: 'Phòng / TB / loại nào']
  frequency String [note: 'monthly | quarterly | yearly']
  checklist Array [note: '[{ item, required }]']
  next_due DateTime [note: 'Lần tiếp theo']
  created_by ObjectId [note: 'FK → users (Maint Staff)']
  status String [note: 'active | paused']
  created_at DateTime
}

Table maintenance_logs {
  _id ObjectId [pk]
  plan_id ObjectId [ref: > maintenance_plans._id]
  equipment_id ObjectId [ref: > equipment._id]
  checked_by ObjectId [note: 'FK → users (Maint Staff)']
  check_date DateTime
  checklist_results Array [note: '[{ item, passed, note }]']
  status String [note: 'passed | failed | needs_repair']
  auto_repair_id ObjectId [note: 'FK → repairs (nếu tạo ticket)']
  notes String
}

Table inventory_sessions {
  _id ObjectId [pk]
  name String [note: 'Tên đợt kiểm kê']
  scope_type String [note: 'building | floor | room']
  scope_ids Array [note: 'Phạm vi']
  created_by ObjectId [note: 'FK → users (Maint Staff)']
  date DateTime
  status String [note: 'draft | in_progress | completed | reconciled']
  completed_at DateTime
  created_at DateTime
}

Table inventory_logs {
  _id ObjectId [pk]
  session_id ObjectId [ref: > inventory_sessions._id]
  equipment_id ObjectId [ref: > equipment._id]
  scanned_room_id ObjectId [ref: > rooms._id]
  scanned_by ObjectId [note: 'FK → users (Maint Staff)']
  scanned_at DateTime
  status String [note: 'matched | missing | damaged | wrong_location']
  note String
}
