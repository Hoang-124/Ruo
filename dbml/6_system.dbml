// ═══════════════════════════════════════
// MODULE 6: NOTIFICATION & AUDIT
// Actor: Admin (View audit log, Verify audit chain, Export audit log)
//        System (Auto-send notifications, ghi audit mọi thao tác + đăng nhập)
// ═══════════════════════════════════════

Table users {
  _id ObjectId [pk]
  code String [unique]
  full_name String
  role String [note: 'lecturer | facility_manager | technician | admin']
}

Table notifications {
  _id ObjectId [pk]
  user_id ObjectId [ref: > users._id]
  type String [note: 'incident_reported | repair_assigned | repair_resolved | repair_unrepairable | replacement_needed | movement_ordered | parts_request | disposal_request | warranty_expiring | deadline_overdue']
  title String
  message String [note: 'Nội dung sinh từ hằng số trong code']
  reference_type String [note: 'repair | equipment_movement | disposal | equipment | parts_request']
  reference_id ObjectId [note: 'Link đến document gốc']
  is_read Boolean [note: 'Default false']
  created_at DateTime
}

Table audit_logs {
  _id ObjectId [pk]
  action String [note: 'create | update | delete | approve | login_success | login_failed | logout | password_reset']
  target_table String [note: 'Collection nào']
  entity_id ObjectId [note: 'Record nào']
  user_id ObjectId [ref: > users._id, note: 'nullable (đăng nhập sai email)']
  actor_email String [note: 'Email đã nhập khi đăng nhập']
  old_value JSON
  new_value JSON
  ip_address String
  user_agent String
  hash_sha256 String [note: 'Hash hiện tại']
  previous_hash String [note: 'Hash trước → chuỗi SHA-256. Không đặt TTL']
  created_at DateTime
}

// notification_templates đã bỏ: nội dung thông báo viết thẳng trong code
