{
  "name": "ruo-server",
  "version": "1.0.0",
  "description": "Backend API Server for Ruo University Facilities Management System (UFMS)",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeds/seedDatabase.js",
    "seed:transfer-demo": "node src/seeds/seedTransferDemo.js",
    "test": "npm run test:unit && npm run test:uc",
    "test:unit": "node -e \"import('node:child_process').then(({execFileSync})=>import('node:fs').then(fs=>execFileSync(process.execPath,['--test',...fs.readdirSync('test').filter(f=>f.endsWith('.test.js')).map(f=>'test/'+f)],{stdio:'inherit'})))\"",
    "test:task-scope": "node -e \"import('node:child_process').then(({execFileSync})=>import('node:fs').then(fs=>execFileSync(process.execPath,['--test',...fs.readdirSync('integration').filter(f=>f.endsWith('.test.js')).map(f=>'integration/'+f)],{stdio:'inherit'})))\"",
    "test:uc": "node src/tests/test_uc15_uc16.js && node src/tests/test_uc10_1.js && node src/tests/test_uc10_2.js && node src/tests/test_uc10_3.js && node src/tests/test_uc10_4.js && node src/tests/test_uc10_5.js && node src/tests/test_uc10_6.js && node src/tests/test_uc10_7.js && node src/tests/test_uc12_1.js && node src/tests/test_uc12_2.js && node src/tests/test_uc3_1.js && node src/tests/test_uc3_2.js",
    "test:rbac": "node src/tests/test_uc12_1.js",
    "test:rbac2": "node src/tests/test_uc12_2.js",
    "test:uc3_1": "node src/tests/test_uc3_1.js",
    "test:uc3_2": "node src/tests/test_uc3_2.js",
    "test:equipment": "node src/tests/test_equipment_phase2.js && node src/tests/test_crud_actions.js",
    "test:repair": "node src/tests/test_repair_phase3.js",
    "test:sync": "node src/tests/test_cross_module_sync.js",
    "test:verify": "node src/tests/backendVerification.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "nodemailer": "^10.0.11"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
