PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ruo_db
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
REPORT_INSTITUTION_NAME="TRƯỜNG ĐẠI HỌC · RUO"
# Ruo Cortex Local AI v2.5 runs 100% locally offline by default (zero API key required).
# Set RUO_AI_LOCAL_ONLY=true to strictly disable external LLM calls even if GEMINI_API_KEY is present.
RUO_AI_LOCAL_ONLY=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
