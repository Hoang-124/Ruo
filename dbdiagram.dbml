// ========================================
// RUO - Facility Management System
// 5 Actors: Guest · Lecturer · Facility Manager · Technician · Admin
// 20 Collections · 48 Use Cases
// ========================================
// TIP: Bỏ các ref → users để tránh mạng nhện
// Các trường *_by đều FK → users (ghi trong note)
// ========================================

// ─── 1. AUTH & USER ──────────────────────

TableGroup auth_group {
  users
  roles
  refresh_tokens
  password_resets
}

Table users {
  _id ObjectId [pk]
  code String [unique, note: 'Mã NV / GV']
  email String [unique]
  password_hash String [note: 'BCrypt']
  full_name String
  phone String
  avatar String
  department String [note: 'Khoa / Phòng ban']
  role String [note: 'lecturer | facility_manager | technician | admin']
  status String [note: 'active | locked']
  force_change_pw Boolean
  failed_login_attempts Number [note: '5 lần sai → khoá 15 phút']
  lock_until DateTime
  last_login_at DateTime
  created_at DateTime
  updated_at DateTime
}

Table roles {
  _id ObjectId [pk]
  name String [unique, note: 'lecturer | facility_manager | technician | admin']
  permissions Array [note: 'Mảng quyền']
}

Table refresh_tokens {
  _id ObjectId [pk]
  user_id ObjectId [ref: > users._id]
  token_hash String
  device_info String
  ip_address String
  expires_at DateTime [note: 'TTL 7 ngày']
  is_revoked Boolean
  created_at DateTime
}

Table password_resets {
  _id ObjectId [pk]
  email String
  otp_hash String [note: 'BCrypt OTP 6 số']
  purpose String [note: 'register | reset_password']
  attempts Number [note: 'Tối đa 3 lần nhập sai']
  expires_at DateTime [note: 'TTL 15 phút']
  is_used Boolean
  created_at DateTime
}

// ─── 2. MASTER DATA ──────────────────────

TableGroup master_data {
  categories
  suppliers
  repair_units
  rooms
  spare_parts
}

Table categories {
  _id ObjectId [pk]
  code String [unique]
  name String
  description String
}

Table suppliers {
  _id ObjectId [pk]
  code String [unique]
  name String
  phone String
  email String
  address String
  contact String
}

Table repair_units {
  _id ObjectId [pk]
  code String [unique]
  name String
  specialty String
  phone String
  address String
}

Table rooms {
  _id ObjectId [pk]
  code String [unique]
  name String
  building String
  floor Number
  room_type String [note: 'lecture | lab | office | warehouse']
  capacity Number
  area Number [note: 'm²']
  layout_image String [note: 'Sơ đồ phòng']
  department String
  required_equipment Array [note: 'Định mức: [{ category_id, quantity }]']
  status String [note: 'available | maintenance | inactive']
  created_at DateTime
  updated_at DateTime
}

Table spare_parts {
  _id ObjectId [pk]
  code String [unique]
  name String
  stock Number
  min_stock Number [note: 'Ngưỡng cảnh báo']
  price Number
  unit String [note: 'Cái, bộ, hộp']
  supplier_id ObjectId [ref: > suppliers._id]
}

// ─── 3. EQUIPMENT, MOVEMENT & DISPOSAL ───

TableGroup equipment_group {
  equipment
  equipment_movements
  disposals
  import_sessions
}

Table equipment {
  _id ObjectId [pk]
  code String [unique, note: 'Mã tài sản']
  qr_code String [unique]
  serial_number String
  name String
  brand String
  model String
  category_id ObjectId [ref: > categories._id]
  room_id ObjectId [ref: > rooms._id, note: 'Vị trí hiện tại (phòng hoặc kho). null = đang ở đơn vị sửa ngoài']
  supplier_id ObjectId [ref: > suppliers._id]
  price Number
  purchase_date DateTime
  warranty_expiry DateTime
  warranty_status String [note: 'active | expired | extended']
  images Array
  depreciation_rate Number [note: '% / năm']
  status String [note: 'in_use | in_stock | broken | repairing | pending_disposal | disposed | lost']
  created_at DateTime
  updated_at DateTime
}

Table equipment_movements {
  _id ObjectId [pk]
  equipment_id ObjectId [ref: > equipment._id]
  type String [note: 'transfer | replacement | repair_out | repair_return | to_stock']
  from_room_id ObjectId [ref: > rooms._id, note: 'nullable']
  to_room_id ObjectId [ref: > rooms._id, note: 'nullable (repair_out ra đơn vị ngoài)']
  repair_id ObjectId [ref: > repairs._id, note: 'nullable, gắn khi di chuyển do sửa chữa']
  ordered_by ObjectId [note: 'FK → users (Facility Manager)']
  performed_by ObjectId [note: 'FK → users (Technician)']
  reason String
  status String [note: 'pending | completed | cancelled']
  created_at DateTime
  completed_at DateTime
}

Table disposals {
  _id ObjectId [pk]
  equipment_id ObjectId [ref: > equipment._id]
  repair_id ObjectId [ref: > repairs._id, note: 'Phiếu sửa kết luận unrepairable']
  proposed_by ObjectId [note: 'FK → users (Facility Manager)']
  approved_by ObjectId [note: 'FK → users (Admin)']
  reason String
  reject_reason String
  decision_number String [note: 'Số QĐ thanh lý']
  recovery_value Number
  status String [note: 'proposed | approved | rejected | completed']
  proposed_at DateTime
  approved_at DateTime
  completed_at DateTime
}

Table import_sessions {
  _id ObjectId [pk]
  uploaded_by ObjectId [note: 'FK → users (Facility Manager)']
  file_name String
  total_rows Number
  success_count Number
  error_count Number
  errors Array [note: '[{ row, field, message }]']
  status String [note: 'validating | validated | importing | completed | failed']
  created_at DateTime
  completed_at DateTime
}

// ─── 4. REPAIR FLOW ──────────────────────

TableGroup repair_group {
  repairs
  repair_logs
  parts_requests
}

Table repairs {
  _id ObjectId [pk]
  equipment_id ObjectId [ref: > equipment._id, note: 'Đồ hỏng']
  source String [note: 'lecturer_report | inventory_check']
  reported_by ObjectId [note: 'FK → users (Lecturer hoặc Technician khi kiểm kê)']
  incident_description String [note: 'Mô tả sự cố gốc']
  incident_images Array
  reported_at DateTime
  assigned_by ObjectId [note: 'FK → users (Facility Manager)']
  assigned_to ObjectId [note: 'FK → users (Technician)']
  replacement_equipment_id ObjectId [ref: > equipment._id, note: 'Đồ trong kho lấy ra thay, nullable']
  repair_unit_id ObjectId [ref: > repair_units._id, note: 'nullable, khi gửi sửa ngoài']
  damage_level String [note: 'minor | major | critical']
  description String [note: 'Mô tả kỹ thuật']
  total_cost Number
  deadline DateTime
  outcome String [note: 'repaired | unrepairable']
  destination_room_id ObjectId [ref: > rooms._id, note: 'Sửa xong về đâu (phòng hoặc kho)']
  status String [note: 'reported | assigned | in_progress | resolved | unrepairable | closed']
  feedback_rating Number [note: '1-5 sao (Lecturer)']
  feedback_comment String
  feedback_at DateTime
  created_at DateTime
  updated_at DateTime
}

Table repair_logs {
  _id ObjectId [pk]
  repair_id ObjectId [ref: > repairs._id]
  action String [note: 'reported | assigned | in_progress | resolved | unrepairable | closed']
  performed_by ObjectId [note: 'FK → users']
  description String
  cost Number
  images Array
  timestamp DateTime
}

Table parts_requests {
  _id ObjectId [pk]
  repair_id ObjectId [ref: > repairs._id]
  requested_by ObjectId [note: 'FK → users (Technician)']
  approved_by ObjectId [note: 'FK → users (Facility Manager)']
  items Array [note: '[{ part_id → spare_parts, qty, unit_price }]. Đã duyệt = đã xuất kho']
  status String [note: 'pending | approved | rejected']
  reject_reason String
  created_at DateTime
  approved_at DateTime
}

// ─── 5. INVENTORY ────────────────────────

TableGroup inventory_group {
  inventory_sessions
  inventory_logs
}

Table inventory_sessions {
  _id ObjectId [pk]
  name String
  scope_type String [note: 'building | floor | room']
  scope_ids Array
  created_by ObjectId [note: 'FK → users (Facility Manager)']
  date DateTime
  status String [note: 'draft | in_progress | completed | reconciled']
  completed_at DateTime
  created_at DateTime
}

Table inventory_logs {
  _id ObjectId [pk]
  session_id ObjectId [ref: > inventory_sessions._id]
  equipment_id ObjectId [ref: > equipment._id]
  scanned_room_id ObjectId [ref: > rooms._id]
  scanned_by ObjectId [note: 'FK → users (Technician)']
  scanned_at DateTime
  status String [note: 'matched | missing | damaged | wrong_location']
  repair_id ObjectId [ref: > repairs._id, note: 'Phiếu sửa tự tạo khi damaged']
  note String
}

// ─── 6. NOTIFICATION & AUDIT ─────────────

TableGroup system_group {
  notifications
  audit_logs
}

Table notifications {
  _id ObjectId [pk]
  user_id ObjectId [ref: > users._id]
  type String [note: 'incident_reported | repair_assigned | repair_resolved | repair_unrepairable | replacement_needed | movement_ordered | parts_request | disposal_request | warranty_expiring | deadline_overdue']
  title String
  message String
  reference_type String [note: 'repair | equipment_movement | disposal | equipment | parts_request']
  reference_id ObjectId
  is_read Boolean
  created_at DateTime
}

Table audit_logs {
  _id ObjectId [pk]
  action String [note: 'create | update | delete | approve | login_success | login_failed | logout | password_reset']
  target_table String
  entity_id ObjectId
  user_id ObjectId [ref: > users._id, note: 'nullable (đăng nhập sai email)']
  actor_email String
  old_value JSON
  new_value JSON
  ip_address String
  user_agent String
  hash_sha256 String
  previous_hash String [note: 'SHA-256 chain, không đặt TTL']
  created_at DateTime
}
